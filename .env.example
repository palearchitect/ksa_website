# ============================================
# KSA Valuers - Unified Environment Configuration
# ============================================

# --- Frontend Environment Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Server & Database Configuration ---
PORT=5173
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/ksa_valuers

# --- Clerk Authentication ---
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# --- Resend Email Delivery ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@ksavaluers.com
ADMIN_EMAIL=admin@ksavaluers.com

# --- Security & CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://ksavaluers.com,https://api.ksavaluers.com

# --- AI & External Services ---
GEMINI_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=sandbox
