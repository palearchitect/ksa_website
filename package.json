{
  "name": "website",
  "version": "1.0.0",
  "description": "KSA Valuers - Real Estate Valuation in Nigeria",
  "main": "index.js",
  "scripts": {
    "prebuild": "node -e \"try{require('fs').chmodSync('node_modules/.bin/vite', 0o755)}catch(e){}\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend": "cd backend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run backend\"",
    "db:setup": "cd backend && npm run db:setup",
    "start": "cd backend && npm start"
  },
  "keywords": [
    "vue",
    "real estate",
    "valuation",
    "ksa valuers",
    "nigeria"
  ],
  "author": "The Pale Architect",
  "license": "MIT",
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.6.0",
    "decap-cms-app": "^3.10.0",
    "lodash": "^4.17.23",
    "pinia": "^2.3.1",
    "vue": "^3.4.0",
    "vue-meta": "3.0.0-alpha.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^4.5.14"
  }
