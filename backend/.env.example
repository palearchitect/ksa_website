# PostgreSQL Database Configuration
# For local development: postgres://user:password@localhost:5432/ksa_valuers
# For production: Use cloud provider URL (Heroku, AWS RDS, DigitalOcean, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/ksa_valuers
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email Configuration
# EMAIL_PROVIDER options: gmail (default), smtp, sendgrid, aws-ses
EMAIL_PROVIDER=gmail

# Gmail Configuration (if EMAIL_PROVIDER=gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# SendGrid Configuration (if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=your-sendgrid-api-key

# AWS SES Configuration (if EMAIL_PROVIDER=aws-ses)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_SES_REGION=us-east-1

# General Email Settings
ADMIN_EMAIL=admin@ksavaluers.com
EMAIL_FROM=noreply@ksavaluers.com
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=1000

# API Configuration
PORT=3000
VITE_API_URL=http://localhost:3000

# CORS Configuration (for production deployment)
# Development: automatically allows localhost:3000 and localhost:5173
# Production: MUST be explicitly set as comma-separated list (https:// required)
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Services
GEMINI_API_KEY=your-gemini-api-key-here

# PostHog Analytics (Backend Telemetry)
POSTHOG_API_KEY=your-posthog-project-api-key
POSTHOG_HOST=https://us.i.posthog.com

# Admin Seeding
# ADMIN_PASSWORD is REQUIRED for server startup.
# Must be at least 12 characters with uppercase, lowercase, numbers, and special characters.
# CRITICAL: Change this immediately on deployment and use a secure secrets manager.
# Example: MySecureAdmin_2024!
ADMIN_PASSWORD=MySecureAdmin_2024!

