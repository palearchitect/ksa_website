# PostgreSQL Database Configuration
# For local development: postgres://user:password@localhost:5432/ksa_valuers
# For production: Use cloud provider URL (Heroku, AWS RDS, DigitalOcean, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/ksa_valuers
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email Configuration (Gmail or custom SMTP)
EMAIL_PROVIDER=gmail  # Options: gmail, sendgrid, smtp, aws-ses
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
ADMIN_EMAIL=admin@ksavaluers.com

# API Configuration
PORT=3000
VITE_API_URL=http://localhost:3000

# AI Services
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Additional Providers
# SENDGRID_API_KEY=your-sendgrid-key
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret

# Admin Seeding
ADMIN_PASSWORD=ChangeMeNow_123  # MUST change in production!
ADMIN_EMAIL=admin@ksavaluers.com
